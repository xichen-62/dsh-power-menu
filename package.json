{
  "name": "dsh-power-menu",
  "version": "0.1.18",
  "description": "给 DSH 桌面版加一个右上角电源按钮。点开是 Windows 电源菜单风格的小卡片，只有「关闭DSH」和「重启DSH」：关闭结束整个应用，重启会自动把窗口拉回来。纯本地，只监听回环地址。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "enable.ps1",
    "install.ps1",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "power",
    "power-menu",
    "restart",
    "shutdown",
    "windows",
    "desktop"
  ],
  "author": "xichen-62",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xichen-62/dsh-power-menu.git"
  },
  "homepage": "https://github.com/xichen-62/dsh-power-menu#readme",
  "bugs": {
    "url": "https://github.com/xichen-62/dsh-power-menu/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/helper.cjs && node -e \"const fs=require('node:fs'); JSON.parse(fs.readFileSync('package.json','utf8')); console.log('package.json ok')\"",
    "test": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  }
}
